      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# 1. Load your uploaded data\n",
        "df = pd.read_csv('/root/.cache/kagglehub/datasets/sukhmandeepsinghbrar/housing-price-dataset/versions/1/Housing.csv')\n",
        "\n",
        "# 2. Select the 9 features defined in your PCA slide\n",
        "# These features drive the 'Size/Wealth' and 'Location/Luxury' components\n",
        "features = ['price', 'bedrooms', 'bathrooms', 'sqft_living', 'sqft_lot',\n",
        "            'floors', 'waterfront', 'view', 'condition']\n",
        "\n",
        "# Filter data and handle missing values\n",
        "data_subset = df[features].dropna()\n",
        "\n",
        "# 3. Standardize the data (PCA is scale-sensitive)\n",
        "scaler = StandardScaler()\n",
        "scaled_data = scaler.fit_transform(data_subset)\n",
        "\n",
        "# 4. Run PCA to get 2 components\n",
        "pca = PCA(n_components=2)\n",
        "pca_results = pca.fit_transform(scaled_data)\n",
        "\n",
        "# Create a DataFrame for plotting\n",
        "pca_df = pd.DataFrame(data=pca_results, columns=['PC1', 'PC2'])\n",
        "\n",
        "# 5. Generate the Plot\n",
        "plt.figure(figsize=(12, 8), dpi=100)\n",
        "sns.set_context(\"talk\") # Makes labels larger and more readable for slides\n",
        "sns.set_style(\"whitegrid\", {'axes.spines.right': False, 'axes.spines.top': False})\n",
        "\n",
        "# Create the scatter plot\n",
        "# We use a 'mako' or 'flare' palette for a sleek, modern look\n",
        "plot = sns.scatterplot(\n",
        "    data=pca_df,\n",
        "    x='PC1',\n",
        "    y='PC2',\n",
        "    alpha=0.5,\n",
        "    s=25,\n",
        "    color='#34495e', # Professional slate blue\n",
        "    edgecolor='w',\n",
        "    linewidth=0.5\n",
        ")\n",
        "\n",
        "# 6. Custom Styling to match your slide labels\n",
        "plt.title('Technique 1: PCA Dimensionality Reduction', fontsize=20, fontweight='bold', pad=20)\n",
        "plt.xlabel('Principal Component 1: Size & Wealth Scale', fontsize=14)\n",
        "plt.ylabel('Principal Component 2: Location & Luxury Score', fontsize=14)\n",
        "\n",
        "# Add a text box explaining the variance (Standard PCA practice)\n",
        "explained_var = pca.explained_variance_ratio_.sum() * 100\n",
        "plt.text(pca_df['PC1'].max()*0.7, pca_df['PC2'].max()*0.9,\n",
        "         f'Total Variance Explained: {explained_var:.1f}%',\n",
        "         bbox=dict(facecolor='white', alpha=0.8, edgecolor='none'))\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# Load the data\n",
        "df = pd.read_csv('/root/.cache/kagglehub/datasets/sukhmandeepsinghbrar/housing-price-dataset/versions/1/Housing.csv')\n",
        "\n",
        "# Features from your Slide 3\n",
        "features = ['price', 'bedrooms', 'bathrooms', 'sqft_living', 'sqft_lot',\n",
        "            'floors', 'waterfront', 'view', 'condition']\n",
        "x = StandardScaler().fit_transform(df[features].dropna())\n",
        "\n",
        "# PCA\n",
        "pca = PCA(n_components=2)\n",
        "components = pca.fit_transform(x)\n",
        "\n",
        "# Plotting\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.set_style(\"white\")\n",
        "plt.scatter(components[:, 0], components[:, 1], alpha=0.4, c='#10b981', s=20)\n",
        "\n",
        "# EXACT LABELS FROM YOUR PPT\n",
        "plt.title('Technique 1: PCA 2D Market Map', fontsize=15, fontweight='bold')\n",
        "plt.xlabel('PC1: Size & Wealth Scale (sqft, price, rooms)', fontsize=12)\n",
        "plt.ylabel('PC2: Location & Luxury Score (waterfront, views)', fontsize=12)\n",
        "\n",
        "sns.despine()\n",
        "plt.show()"
      ]
    }
  ]
}